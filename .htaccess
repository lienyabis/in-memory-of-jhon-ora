# ============================================================
# John Paul Ora Memorial — ALL-IN-ONE (React build + PHP API in one root)
# Apache rules for InfinityFree (and any Apache host).
# ============================================================
RewriteEngine On

# Pass Authorization header to PHP (needed for Bearer JWT)
RewriteCond %{HTTP:Authorization} ^(.*)$
RewriteRule ^(.*)$ - [E=HTTP_AUTHORIZATION:%1]

# 1) API: /api/... -> api.php with PATH_INFO (same-domain, no CORS needed)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^api(/.*)?$ api.php$1 [QSA,L]

# 2) Existing files/folders (assets, jhon_ora.jpeg, uploads, *.php) are
#    served/executed as-is and never touched by the SPA fallback.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 3) SPA fallback: React Router routes (/memories /login /signup /dashboard)
#    -> index.html. Only extension-less, non-/api paths qualify, so a
#    missing .js/.css/image still returns a real 404 instead of HTML.
RewriteCond %{REQUEST_URI} !^/api(/|$)
RewriteCond %{REQUEST_URI} !\.(php|phtml|js|mjs|css|png|jpe?g|gif|webp|ico|svg|woff2?|ttf|otf|eot|map|txt|xml|json|pdf|zip)$
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]

# Protect secrets / internals
<FilesMatch "^\.ht">
  Require all denied
</FilesMatch>
<FilesMatch "^(\.env|composer\.json|composer\.lock)$">
  Require all denied
</FilesMatch>
<Files "mail.log">
  Require all denied
</Files>
# API test runner contains seeded credentials — never expose it
<Files "api_test.php">
  Require all denied
</Files>