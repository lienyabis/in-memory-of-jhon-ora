SUPERADMIN_EMAIL=superadmin@example.com
SUPERADMIN_PASSWORD=change-me-to-a-strong-password
JWT_SECRET=change-this-to-a-long-random-secret
PORT=5000
# Production: set both to your Render URL, e.g. https://jhon-ora-memorial.onrender.com
SITE_URL=https://jhon-ora-memorial.onrender.com
CLIENT_URL=https://jhon-ora-memorial.onrender.com
# Render persistent disk mount (render.yaml sets DATA_DIR=/var/data).
# Leave empty for local dev (uses server folder).
DATA_DIR=
DISABLE_CRON=0
# Death anniversary (month 1-12, day 1-31) - UPDATE THIS to Jhon's actual date
DEATH_MONTH=10
DEATH_DAY=7
# Email (Gmail example - use App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="In Loving Memory of Jhon Ora <no-reply@example.com>"


