# SPLIT project backend env: React (Vite :5173, or any static host) + this PHP API (:8000).
# Local: copy to .env (already provided for local dev).
# Hosting: no env panel — either edit config.php defaults directly
# or upload this file as .env (it is protected by .htaccess).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=memorial
DB_USER=root
DB_PASS=

JWT_SECRET=f7dfca6ec9c4b0318991858ea9aaf2bde575796979f16fb17cdf52b9dcc2c3ac

SUPERADMIN_EMAIL=superadmin@jhonora.memorial
SUPERADMIN_PASSWORD=
SUPERADMIN_NAME=Super Admin

DEATH_MONTH=09
DEATH_DAY=29

# This backend's own URL (anniversary email links). Local dev:
SITE_URL=http://localhost:8000
# On hosting set to e.g. https://your-api.infinityfreeapp.com
# The PUBLIC site URL (React frontend). Local dev:
FRONTEND_URL=http://localhost:5173
# On hosting set to e.g. https://your-site.vercel.app

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="In Loving Memory of John Paul Ora <no-reply@jhonora.memorial>"

CRON_SECRET=

# Photos are stored as MySQL BLOBs (photos table auto-created).
# Allowed formats are fixed: JPG, PNG, GIF, WEBP (validated by real bytes).
UPLOAD_MAX_MB=8
UPLOAD_MAX_FILES=6
# Photos larger than this (long edge, px) are downscaled when GD exists.
IMAGE_MAX_DIMENSION=1600
IMAGE_JPEG_QUALITY=82
