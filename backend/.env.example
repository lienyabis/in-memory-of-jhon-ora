# Local dev: copy to backend/.env and edit.
# InfinityFree: there is NO env panel — instead edit backend/config.php
# defaults directly, OR upload this file as backend/.env (works, but
# config.php defaults are simpler and survive re-uploads of backend/).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=memorial
DB_USER=root
DB_PASS=

JWT_SECRET=change-this-to-a-long-random-secret-min-32-chars

SUPERADMIN_EMAIL=superadmin@jhonora.memorial
SUPERADMIN_PASSWORD=JhonOra2024!
SUPERADMIN_NAME=Super Admin

DEATH_MONTH=09
DEATH_DAY=29
SITE_URL=http://localhost:5173

# Local Vite dev server; in production set to your Render URL
FRONTEND_URL=http://localhost:5173

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="In Loving Memory of Jhon Ora <no-reply@jhonora.memorial>"

CRON_SECRET=change-me-cron-secret

# Photos are stored as MySQL BLOBs (photos table auto-created).
# Allowed formats are fixed: JPG, PNG, GIF, WEBP (validated by real bytes).
UPLOAD_MAX_MB=8
UPLOAD_MAX_FILES=6
# Photos larger than this (long edge, px) are downscaled when GD exists.
IMAGE_MAX_DIMENSION=1600
IMAGE_JPEG_QUALITY=82
